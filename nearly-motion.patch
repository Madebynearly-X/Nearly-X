+++ b/motion-advanced.css
@@ -0,0 +1,353 @@
+/* ==========================================================================
+   motion-advanced.css  |  NEARLY Studio
+   Additive layer. Load AFTER styles.css (and selected-concepts.css).
+   Reuses the site's own tokens and class names (.button, .section-head).
+   Does not redefine .reveal, .scroll-progress, the .tile spotlight or any
+   page-load animation; those stay exactly as styles.css + script.js have them.
+   ========================================================================== */
+
+/* ---- Tokens --------------------------------------------------------------- */
+:root {
+  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
+  --dur-fast: 150ms;
+  --dur-base: 250ms;
+  --dur-slow: 500ms;
+
+  /* Fallback first: a browser without linear() would otherwise drop the whole
+     transition declaration that uses var(--spring). */
+  --spring: var(--ease-out);
+}
+
+@supports (transition-timing-function: linear(0, 1)) {
+  :root {
+    --spring: linear(
+      0, 0.009, 0.035 2.1%, 0.141, 0.281 6.7%, 0.723 12.9%, 0.938 16.7%,
+      1.017, 1.077, 1.121, 1.149 24.3%, 1.159, 1.163, 1.161, 1.154 29.9%,
+      1.129 32.8%, 1.051 39.6%, 1.017 43.1%, 0.991, 0.977 51%, 0.974 53.8%,
+      0.975 57.1%, 0.997 69.8%, 1.003 76.9%, 1.004 83.8%, 1
+    );
+  }
+}
+
+/* ---- Content must stay visible when JavaScript is off --------------------- */
+/* styles.css hides .reveal by default and only script.js shows it. */
+@media (scripting: none) {
+  .reveal {
+    opacity: 1;
+    transform: none;
+    transition: none;
+  }
+}
+
+/* ---- Lively motion: springs, bounce, magnetic pull ------------------------ */
+/* Everything bouncy lives inside no-preference. With "reduce motion" on, the
+   site's own reduced-motion rules in styles.css apply untouched. */
+@media (prefers-reduced-motion: no-preference) {
+  /* Reveals: styles.css fades each block in; this adds a springy rise with a
+     small overshoot on top. Kept shorter (550ms) than the 650ms opacity fade so
+     script.js can still clear --d on transitionend without a visible jump. */
+  .reveal.is-visible {
+    animation: spring-in 550ms var(--spring) backwards;
+    animation-delay: var(--d, 0s);
+  }
+
+  @keyframes spring-in {
+    from {
+      transform: translateY(38px) scale(0.96);
+    }
+  }
+
+  /* Cards: bouncy lift on hover. Same property list as styles.css, only the
+     transform timing changes, so shadow / padding / background still animate. */
+  .tile {
+    transition:
+      opacity 0.65s,
+      transform 600ms var(--spring),
+      box-shadow 0.45s,
+      padding 0.3s,
+      background 0.3s;
+    transition-delay: var(--d, 0s);
+  }
+
+  .tile:hover {
+    transform: translateY(-10px) scale(1.015);
+  }
+
+  /* Buttons: springy hover, snappy press, magnetic pull (see script) */
+  .button {
+    transition:
+      background-color 0.2s ease,
+      color 0.2s ease,
+      transform 550ms var(--spring),
+      translate 250ms var(--ease-out);
+  }
+
+  .button:hover {
+    transform: translateY(-2px) scale(1.05);
+  }
+
+  .button--quiet:hover {
+    transform: translateX(4px);
+  }
+
+  .button:active {
+    transform: scale(0.93);
+    transition-duration: 0.2s, 0.2s, 90ms, 250ms;
+  }
+
+  .button--quiet:active {
+    transform: scale(0.97);
+  }
+
+  .button {
+    translate: var(--mag-x, 0px) var(--mag-y, 0px);
+  }
+
+  /* Price pop when the payment-plan switch changes the numbers */
+  [data-plan-price],
+  [data-plan-total] {
+    display: inline-block;
+  }
+
+  .is-popping {
+    animation: pop 600ms var(--spring) backwards;
+    animation-delay: var(--pop-delay, 0ms);
+  }
+
+  @keyframes pop {
+    from {
+      transform: scale(1.22);
+      opacity: 0.2;
+    }
+  }
+}
+
+/* No-motion baseline: keep the press feedback, nothing animated */
+@media (prefers-reduced-motion: reduce) {
+  .button:active {
+    transform: scale(0.97);
+  }
+}
+
+/* ---- Before / after comparison (illustrative, CSS-built, no photos) ------- */
+.cmp {
+  max-width: 1000px;
+  margin: 0 auto;
+}
+
+.cmp__stage {
+  --split: 50%;
+  container-type: inline-size;
+  position: relative;
+  aspect-ratio: 16 / 10;
+  overflow: hidden;
+  border: 1px solid var(--line);
+  border-radius: var(--radius);
+  background: #fff;
+  box-shadow: var(--shadow);
+  user-select: none;
+}
+
+.cmp__layer {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+}
+
+/* The focused page sits on top and is clipped from the right. clip-path is
+   compositor-friendly and avoids resizing anything while dragging. */
+.cmp__layer--after {
+  clip-path: inset(0 calc(100% - var(--split)) 0 0);
+}
+
+.cmp__tag {
+  position: absolute;
+  bottom: 3cqw;
+  padding: 0.5em 0.9em;
+  border-radius: 999px;
+  font-size: max(11px, 1.3cqw);
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  z-index: 1;
+}
+
+@container (max-width: 520px) {
+  .cmp__tag {
+    padding: 0.4em 0.75em;
+    font-size: 10px;
+  }
+}
+
+.cmp__layer--before .cmp__tag {
+  right: 3cqw;
+  background: rgb(29 29 31 / 0.82);
+  color: #fff;
+}
+
+.cmp__layer--after .cmp__tag {
+  left: 3cqw;
+  background: var(--blue);
+  color: #fff;
+}
+
+/* Generic template mock: busy and unfocused on purpose */
+.cmp__layer--before {
+  background: #e9e9ee;
+  color: #3a3a3c;
+  font-family: Arial, Helvetica, sans-serif;
+}
+
+.cmp__bar {
+  display: flex;
+  justify-content: space-between;
+  gap: 2cqw;
+  padding: 2.2cqw 3cqw;
+  background: #cfcfd6;
+  font-size: max(8px, 1.1cqw);
+}
+
+.cmp__bar span {
+  opacity: 0.8;
+}
+
+.cmp__banner {
+  margin: 2cqw 3cqw 0;
+  padding: 3cqw;
+  background: #b7b7c0;
+  font-size: max(11px, 2.6cqw);
+  font-weight: 700;
+  text-transform: uppercase;
+  text-align: center;
+}
+
+.cmp__clutter {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 1.6cqw;
+  margin: 2cqw 3cqw 0;
+}
+
+.cmp__clutter i {
+  display: block;
+  height: 8cqw;
+  background: #d5d5dc;
+  border: 1px solid #bdbdc6;
+}
+
+.cmp__btns {
+  display: flex;
+  justify-content: space-between;
+  gap: 1.4cqw;
+  margin: 2cqw 3cqw 0;
+}
+
+.cmp__btns b {
+  padding: 0.9cqw 1.8cqw;
+  background: #8e8e98;
+  color: #fff;
+  font-size: max(8px, 1.1cqw);
+  font-weight: 400;
+}
+
+/* Focused page mock: one message, one next step */
+.cmp__layer--after {
+  justify-content: center;
+  align-items: flex-start;
+  padding: 0 6cqw;
+  background: linear-gradient(120deg, #f9f9fb, #e9eef7);
+  color: var(--ink);
+}
+
+.cmp__kicker {
+  margin: 0 0 1.4cqw;
+  font-size: max(8px, 1.1cqw);
+  font-weight: 700;
+  letter-spacing: 0.16em;
+  color: var(--muted);
+}
+
+.cmp__headline {
+  margin: 0;
+  max-width: 8em;
+  font: 800 min(5.2cqw, 56px) / 0.98 Manrope, sans-serif;
+  letter-spacing: -0.07em;
+}
+
+.cmp__sub {
+  margin: 1.6cqw 0 0;
+  max-width: 36cqw;
+  font-size: max(10px, 1.5cqw);
+  color: var(--muted);
+}
+
+.cmp__cta {
+  margin-top: 2.4cqw;
+  padding: 1.1cqw 2.4cqw;
+  border-radius: 999px;
+  background: var(--ink);
+  color: #fff;
+  font-size: max(9px, 1.3cqw);
+  font-weight: 600;
+}
+
+/* Handle. Visual only; the invisible range input does the work. */
+.cmp__handle {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: var(--split);
+  width: 2px;
+  margin-left: -1px;
+  background: #fff;
+  box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08);
+  pointer-events: none;
+  z-index: 2;
+}
+
+.cmp__knob {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  display: grid;
+  place-items: center;
+  width: 44px;
+  height: 44px;
+  border-radius: 50%;
+  background: #fff;
+  color: var(--ink);
+  font-size: 14px;
+  font-weight: 700;
+  box-shadow: 0 8px 24px rgb(0 0 0 / 0.28);
+  transform: translate(-50%, -50%);
+}
+
+.cmp__range {
+  position: absolute;
+  inset: 0;
+  z-index: 3;
+  width: 100%;
+  height: 100%;
+  margin: 0;
+  opacity: 0;
+  cursor: ew-resize;
+  /* Let vertical swipes scroll the page; only horizontal drags move the slider. */
+  touch-action: pan-y;
+}
+
+.cmp__range[hidden] {
+  display: none;
+}
+
+/* The input is invisible, so show keyboard focus on the knob instead. */
+.cmp__range:focus-visible ~ .cmp__handle .cmp__knob {
+  outline: 3px solid #005fcc;
+  outline-offset: 3px;
+}
+
+.cmp__note {
+  margin: 14px 0 0;
+  text-align: center;
+  font-size: 12px;
+  color: var(--muted);
+}
