{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nearly-marketing-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dashboard",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nearly-marketing-agent",
      "database_id": "5c52c4f6-f1e1-4030-b7ae-b84324c1f3be",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "LLM_PROVIDER": "mock",
    "LINKEDIN_API_VERSION": "202609"
  }
}
