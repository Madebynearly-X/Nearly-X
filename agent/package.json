{
  "name": "nearly-marketing-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler types && tsc --noEmit && wrangler deploy --dry-run --outdir=dist && node scripts/check-dashboard.mjs",
    "typecheck": "wrangler types && tsc --noEmit",
    "types": "wrangler types",
    "lint": "eslint src test",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "hono": "4.13.13",
    "jose": "6.2.12",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
